{
  "name": "mahjong-exchange",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server/index.ts --dev",
    "build": "npm run typecheck && vite build",
    "start": "NODE_ENV=production tsx src/server/index.ts",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "oxlint src tests scripts e2e",
    "test": "vitest run",
    "test:watch": "vitest",
    "bot-eval": "tsx scripts/bot-eval.ts",
    "fit-model": "tsx scripts/fit-model.ts",
    "experiment": "tsx scripts/experiment.ts",
    "e2e": "npm run build && PLAYWRIGHT_BROWSERS_PATH=0 playwright test",
    "load-test": "tsx scripts/load-test.ts"
  },
  "dependencies": {
    "@pai-forge/riichi-mahjong": "1.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "oxlint": "^1.94.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
